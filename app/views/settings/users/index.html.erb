<% content_for :title, "ユーザー管理" %>
<h1>ユーザー管理</h1>
<%= render "settings/nav" %>

<div class="actions">
  <%= link_to "ユーザーを追加", new_settings_user_path, class: "button" %>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>メールアドレス</th>
        <th>権限</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.email_address %><%= "（あなた）" if user == current_user %></td>
          <td><%= user.admin? ? "管理者" : "担当者" %></td>
          <td>
            <%= link_to "編集", edit_settings_user_path(user), class: "button-link" %>
            <% unless user == current_user %>
              <%= button_to "削除", settings_user_path(user), method: :delete, class: "danger",
                            form: { style: "display:inline", data: { turbo_confirm: "このユーザーを削除します。よろしいですか？" } } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

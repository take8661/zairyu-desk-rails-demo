<% content_for :title, "組織名の変更" %>
<h1>組織名の変更</h1>
<%= render "settings/nav" %>

<div class="card">
  <%= form_with model: @organization, url: settings_organization_path, method: :patch do |form| %>
    <%= render "shared/errors", record: @organization %>
    <div class="field">
      <%= form.label :name, "組織名" %>
      <%= form.text_field :name, required: true %>
    </div>
    <div class="actions">
      <%= form.submit "更新する" %>
      <%= link_to "キャンセル", settings_organization_path, class: "button-link" %>
    </div>
  <% end %>
</div>
